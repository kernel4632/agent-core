{
    // 新实现（src/、根目录 index.ts、tests/、scripts/）的类型检查配置。
    // Bun 直接运行 .ts，所以这里只做类型检查（noEmit）；发布时另用 emitDeclarationOnly 生成 .d.ts。
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ESNext"],
        "types": ["bun"],
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": true,
        "resolveJsonModule": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true
    },
    "include": ["src/**/*.ts", "index.ts", "tests/**/*.ts", "scripts/**/*.ts"]
}
